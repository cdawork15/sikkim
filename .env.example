# Local PostgreSQL. Replace both passwords and match their URL values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://sikkim_app:replace-local-app-password@127.0.0.1:5432/sikkim_dev
MIGRATION_DATABASE_URL=postgresql://sikkim_owner:replace-local-owner-password@127.0.0.1:5432/sikkim_dev
# Setup only: your existing PostgreSQL administrator is used via PGUSER.
# If unset, psql uses your operating-system username. Set PGPASSWORD only if required.
PGHOST=127.0.0.1
PGPORT=5432
DB_OWNER_PASSWORD=replace-local-owner-password
DB_APP_PASSWORD=replace-local-app-password
DB_TLS=false
# Production also requires PUBLIC_API_ORIGIN=https://your-api.example
# Set DB_TLS=true in production; optional DB_CA_FILE is a trusted CA PEM path.
# TRUST_PROXY_CIDRS may contain only the actual ingress proxy IPs/CIDRs.

# Real host applications: disabled (closed) or manual (an admin checks identity
# in person, by video call or with documents, and records the method).
HOST_VERIFICATION_MODE=manual

# Passwordless sign-in codes by email or SMS.
#   disabled — off; console — codes printed in the server log (local development only).
# Production needs an email/SMS provider (see README) before codes can be sent.
OTP_DELIVERY=console
OTP_SECRET=replace-with-a-random-secret-at-least-32-characters
# Country code added to local phone numbers (no +). 91 = India.
OTP_DEFAULT_COUNTRY_CODE=91

# Local demo accounts only. Must stay false in production.
ENABLE_DEMO_AUTH=false

# Optional local media. Install ffmpeg first (brew install ffmpeg).
# MEDIA_STORAGE_DIR=/absolute/private/path/sikkim-media
# MEDIA_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters

# Single-server HTTPS deployment only: production, verified DB TLS, loopback API/proxy.
# MEDIA_STORAGE_MODE=single_server
# TRUST_PROXY_CIDRS=127.0.0.1/32
# MEDIA_STORAGE_DIR=/var/lib/sikkim/media
# Optional shared-network allowance; individual auth/upload limits still apply.
# REQUESTS_PER_MINUTE=600
