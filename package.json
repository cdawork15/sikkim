{
  "name": "sikkim-experiences-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "db:migrate": "node --env-file-if-exists=.env dist/bin/database.js migrate",
    "db:seed": "node --env-file-if-exists=.env dist/bin/database.js seed",
    "db:reset": "node --env-file-if-exists=.env dist/bin/database.js reset",
    "db:setup": "node --env-file-if-exists=.env db/setup-local.mjs",
    "db:preview": "node --env-file-if-exists=.env dist/bin/database.js preview",
    "db:media-preview": "node --env-file-if-exists=.env dist/bin/media-preview.js"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "fastify": "5.12.8",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "14.0.4"
    }
  }
}
