VITE_DATA_MODE=api
VITE_API_BASE_URL=/v1

# Show AI concept images on `preview-` sample experiences (rights unconfirmed).
# Default: true in `npm run dev`, false in builds. Test deployments only, never production.
# VITE_PREVIEW_IMAGES=false

# Dev server only: where `npm run dev` proxies /v1 (default http://127.0.0.1:3000).
# DEV_API_PROXY_TARGET=http://127.0.0.1:3000
